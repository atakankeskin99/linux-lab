#!/usr/bin/env bash
set -euo pipefail

CONFIG_FILE="${LAN_DROP_V2_CONFIG:-/etc/lan-drop/v2.env}"
SERVICE="lan-drop.service"
URL="https://10.42.0.1:8080"

fail() {
    printf 'Error: %s\n' "$1" >&2
    exit 1
}

[[ ${EUID} -eq 0 ]] || fail "run with sudo: sudo lan-drop {start|stop|status}"
[[ -r ${CONFIG_FILE} ]] || fail "V2 is not installed; run sudo ./install-v2.sh"

# shellcheck source=/dev/null
source "${CONFIG_FILE}"

case "${1:-}" in
    start)
        service_started=false
        if ! systemctl is-active --quiet "${SERVICE}"; then
            systemctl start "${SERVICE}"
            service_started=true
        fi

        if ! nmcli -t -f NAME connection show --active | grep -Fxq "${CONNECTION_NAME}"; then
            if ! nmcli connection up id "${CONNECTION_NAME}" ifname "${WIFI_INTERFACE}"; then
                if [[ ${service_started} == true ]]; then
                    systemctl stop "${SERVICE}"
                fi
                fail "the hotspot failed to start; the prior service state was preserved"
            fi
        fi

        printf '\nLAN Drop V2 is ready.\n'
        printf 'Wi-Fi: %s\n' "${HOTSPOT_SSID}"
        printf 'URL:   %s\n' "${URL}"
        ;;

    stop)
        systemctl stop "${SERVICE}" || true

        if nmcli -t -f NAME connection show --active | grep -Fxq "${CONNECTION_NAME}"; then
            nmcli connection down id "${CONNECTION_NAME}"
        fi

        printf 'LAN Drop V2 stopped.\n'
        ;;

    status)
        printf '=== Hotspot ===\n'
        if nmcli -t -f NAME connection show --active | grep -Fxq "${CONNECTION_NAME}"; then
            nmcli -f NAME,TYPE,DEVICE connection show --active \
                | awk -v name="${CONNECTION_NAME}" 'NR == 1 || $1 == name'
        else
            printf 'inactive\n'
        fi

        printf '\n=== Service ===\n'
        systemctl is-active "${SERVICE}" || true
        ;;

    *)
        printf 'Usage: sudo lan-drop {start|stop|status}\n' >&2
        exit 2
        ;;
esac
