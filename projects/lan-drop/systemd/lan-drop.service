[Unit]
Description=LAN Drop local file transfer service
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=lan-drop
Group=lan-drop
WorkingDirectory=/opt/lan-drop
EnvironmentFile=/etc/lan-drop/lan-drop.env
ExecStart=/opt/lan-drop/.venv/bin/gunicorn \
    --workers 1 \
    --bind 0.0.0.0:8080 \
    --certfile /etc/lan-drop/tls/server.crt \
    --keyfile /etc/lan-drop/tls/server.key \
    --access-logfile - \
    --error-logfile - \
    app:app
Restart=on-failure
RestartSec=3
UMask=0077

NoNewPrivileges=true
PrivateDevices=true
PrivateTmp=true
ProtectControlGroups=true
ProtectHome=true
ProtectHostname=true
ProtectKernelLogs=true
ProtectKernelModules=true
ProtectKernelTunables=true
ProtectSystem=strict
ReadWritePaths=/var/lib/lan-drop/uploads
RestrictRealtime=true
RestrictSUIDSGID=true
LockPersonality=true
CapabilityBoundingSet=
SystemCallArchitectures=native

[Install]
WantedBy=multi-user.target
